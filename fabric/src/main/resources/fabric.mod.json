{
  "schemaVersion": 1,
  "id": "bendygeckocompat",
  "version": "${version}",
  "name": "BendyGeckoCompat",
  "icon": "assets/bendygeckocompat/icon.png",
  "description": "Compatibility addon bringing bending support to GeckoLib 3D armors with Bendy-Lib and Player Animator.",
  "authors": [
    "Tatou8"
  ],
  "contributors": [
    "KosmX"
  ],
  "contact": {
    "homepage": "https://github.com/Tatou8/BendyGeckoCompat",
    "sources": "https://github.com/Tatou8/BendyGeckoCompat.git"
  },
  "license": "CC-BY-4.0 License",
  "environment": "client",
  "entrypoints": {
    "client": [
      "fr.tatou8.bendygeckocompat.fabric.Init"
    ]
  },
  "mixins": [
    "bendygeckocompat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.14",
    "minecraft": ">=1.19.4 <=1.20.4",
    "bendy-lib": ">=4.0.0",
    "geckolib": ">=4.0.0"
  },
  "custom": {
    "modmenu": {
      "badges": ["library"]
    }
  }
}